# Bu dosyayı ".env" adıyla kopyala ve doldur. .env asla GitHub'a gönderilmez.

# ── Alpaca (paper hesabının anahtarları yeterli) ──
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# iex = ücretsiz (tek borsa, hacim düşük görünür) · sip = ücretli Algo Trader Plus (tüm piyasa)
ALPACA_FEED=iex

# ── Telegram ── (README'de nasıl alınacağı yazıyor)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Strateji ──
TIMEFRAME_MIN=1          # 1 veya 5
MACD_FILTER=true         # AL için MACD (mavi) > sinyal (turuncu)
PREMARKET_ENTRY=false    # testlerde premarket girişleri zarar yazdı
MIN_GAIN_PCT=5           # filtreler/ ile aynı: önceki kapanışa göre en az %5
MAX_BARS=20              # en fazla kaç mum tutulur
EOD_EXIT=true            # seans sonunda kapat

# ── Tarayıcı ──
SCAN_INTERVAL_SEC=60
MAX_SYMBOLS=30           # Alpaca ücretsiz planda websocket limiti 30
MIN_PRICE=0.2              # 1 $ altı dahil (ONEG gibi hisseler için)
MAX_PRICE=500
MIN_VOLUME=5000          # IEX verisi toplam hacmin sadece ~%2-3ünü görür; sip kullanırsan 100000 yap

# ── Otomatik işlem (filtreler/OTOMATIK_ISLEM.md — henüz kodlanmadı) ──
AUTO_TRADE=false          # true yapınca Alpaca PAPER hesapta emir verir
MAX_POSITIONS=15
POSITION_USD=500
MAX_SPREAD_PCT=2
ORDER_TIMEOUT_SEC=120
